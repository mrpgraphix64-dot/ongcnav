# NestJS Backend API Configuration
PORT=3001
NODE_ENV=production

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ongc_navratri?schema=public"

# Redis Distributed Cache & Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# REQUIRED — the app refuses to start if this is unset, shorter than 32
# characters, or left as this placeholder value. No hardcoded fallback.
JWT_SECRET=replace_with_secure_random_64_character_hex_key
JWT_EXPIRES_IN=24h

# Domain & CORS
APP_URL=https://ongcnavratri.reworkzone.in
CORS_ORIGINS=https://ongcnavratri.reworkzone.in,http://localhost:3000

# Security Controls
LOAD_TESTING_ENABLED=false

# Internal shared secret required by POST /admin/traffic-test/execute-checkin
# (the x-load-test-auth header must match this exactly). Required for that
# endpoint to work at all — it fails closed if unset. Generate a fresh value
# per environment, e.g.: openssl rand -hex 32
LOAD_TEST_INTERNAL_SECRET=replace_with_random_secret

# Emergency Admin Account (Disabled if strong random password not provided)
ADMIN_EMAIL=admin@ongc.co.in
ADMIN_PASSWORD=replace_with_strong_password

# Razorpay Payment Gateway (Commercial Passes)
# Staging must use Razorpay Test Mode credentials (key ID starts with rzp_test_)
# RAZORPAY_KEY_ID: Public key ID, returned to frontend for Razorpay Checkout
# RAZORPAY_KEY_SECRET: Server-only private key secret (NEVER commit actual credentials)
# RAZORPAY_WEBHOOK_SECRET: Server-only webhook secret (NEVER commit actual credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
