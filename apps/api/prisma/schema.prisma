datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_ADMIN
  GATE_SUPERVISOR
  GATE_MANAGER
  GATE_OPERATOR
  SCANNER_STAFF
  HELP_DESK
  REGISTRATION_STAFF
  VOLUNTEER
  REPORT_VIEWER
}

enum GateType {
  REGULAR
  VIP
  OFFICIAL
  SERVICE
  EMERGENCY
}

enum GateStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AttendeeStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CheckinStatus {
  SUCCESS
  VOIDED
}

enum IncidentCategory {
  TICKET_ISSUE
  CAPACITY_LIMIT
  DUPLICATE_CLAIM
  SECURITY
  CROWD
  MEDICAL
  VIP
  LOST_FOUND
  SYSTEM
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum LoadTestMode {
  DRY_RUN
  REAL_HTTP
}

enum LoadTestStatus {
  PREPARING
  RUNNING
  COMPLETED
  FAILED
}

enum LoadTestScenario {
  NORMAL
  DUPLICATE
  PEAK_BURST
  INVALID_QR
  MIXED
}

enum EmployeeCategory {
  REGULAR
  RETIRED
  CONTRACT
}

enum RegistrationType {
  EMPLOYEE
  COMMERCIAL
  FREE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model User {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  staffId   String?  @unique @map("staff_id") @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      UserRole @default(GATE_OPERATOR)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gateUsers        GateUser[]
  scannedCheckins  DailyCheckin[] @relation("ScannedByUser")
  voidedCheckins   DailyCheckin[] @relation("VoidedByUser")
  scannedLogs      ScanLog[]      @relation("ScanLogUser")
  reportedIncidents Incident[]    @relation("IncidentReporter")
  resolvedIncidents Incident[]    @relation("IncidentResolver")
  auditLogs        AuditLog[]

  @@map("users")
}

model Gate {
  id               BigInt     @id @default(autoincrement())
  name             String     @db.VarChar(255)
  gateNumber       String     @unique @map("gate_number") @db.VarChar(50)
  gateType         GateType   @default(REGULAR) @map("gate_type")
  status           GateStatus @default(ACTIVE)
  capacityPerHour  Int?       @map("capacity_per_hour")
  totalCapacity    Int?       @map("total_capacity")
  capacityEnabled  Boolean    @default(false) @map("capacity_enabled")
  blockWhenFull    Boolean    @default(false) @map("block_when_full")
  isOpen           Boolean    @default(true) @map("is_open")
  isScanningPaused Boolean    @default(false) @map("is_scanning_paused")
  location         String?    @db.VarChar(255)
  description      String?    @db.VarChar(500)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  gateUsers     GateUser[]
  dailyCheckins DailyCheckin[]
  scanLogs      ScanLog[]
  incidents     Incident[]

  @@map("gates")
}

model GateUser {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  gateId     BigInt   @map("gate_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gate Gate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([userId, gateId])
  @@map("gate_users")
}

model Employee {
  id               BigInt           @id @default(autoincrement())
  cpf              String           @unique @db.VarChar(50)
  name             String           @db.VarChar(255)
  designation      String           @db.VarChar(255)
  department       String           @db.VarChar(255)
  phone            String           @db.VarChar(20)
  email            String           @db.VarChar(255)
  photoPath        String?          @map("photo_path") @db.VarChar(500)
  // Legacy/summary field — the employee's own selected dates. No longer the
  // authoritative source for check-in gating; see Attendee.bookingDays for
  // the real per-person value. Kept for backward compatibility with
  // existing data/reads that haven't been migrated to the resolver yet.
  bookingDays      Json             @map("booking_days")
  employeeCategory EmployeeCategory @default(REGULAR) @map("employee_category")
  // Reserved for future category-specific fields (e.g. retirement date for
  // RETIRED, contract end date for CONTRACT). Deliberately unstructured and
  // unused today — no category currently has any fields that differ from
  // the others, so nothing is written here yet. This column exists so that
  // when a real category-specific field is defined, it can be added
  // without a new migration, a new table, or touching existing rows.
  categoryData     Json?            @map("category_data")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  familyMembers FamilyMember[]
  attendees     Attendee[]

  @@index([cpf])
  @@index([phone])
  @@map("employees")
}

model FamilyMember {
  id         BigInt   @id @default(autoincrement())
  employeeId BigInt   @map("employee_id")
  name       String   @db.VarChar(255)
  relation   String   @db.VarChar(100)
  age        Int?
  gender     String?  @db.VarChar(20)
  // Nullable at the DB level for backward compatibility with any existing
  // rows created before this field existed — the API DTO enforces it as
  // required (exact 10-digit Indian mobile) for every new registration.
  phone      String?  @db.VarChar(20)
  photoPath  String?  @map("photo_path") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendee Attendee?

  @@map("family_members")
}

model Attendee {
  id               BigInt           @id @default(autoincrement())
  registrationType RegistrationType @default(EMPLOYEE) @map("registration_type")
  name             String?          @db.VarChar(255)
  mobile           String?          @db.VarChar(20)
  email            String?          @db.VarChar(255)
  category         String?          @default("General") @db.VarChar(50)
  employeeId       BigInt?          @map("employee_id")
  familyMemberId   BigInt?          @unique @map("family_member_id")
  orderId          BigInt?          @map("order_id")
  ticketNumber     String           @unique @map("ticket_number") @db.VarChar(100)
  qrCodeToken      String           @unique @map("qr_code_token") @db.VarChar(100)
  status           AttendeeStatus   @default(ACTIVE)
  // This person's own selected event dates — independent of their employee
  // or other family members. Nullable so pre-migration rows fall back to
  // the legacy Employee.bookingDays via resolveBookingDays().
  bookingDays      Json?            @map("booking_days")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  employee      Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  familyMember  FamilyMember?    @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  order         CommercialOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dailyCheckins DailyCheckin[]
  scanLogs      ScanLog[]
  incidents     Incident[]

  @@index([registrationType])
  @@index([orderId])
  @@index([ticketNumber])
  @@index([qrCodeToken])
  @@index([mobile])
  @@map("attendees")
}

model CommercialOrder {
  id                BigInt                @id @default(autoincrement())
  orderNumber       String                @unique @map("order_number") @db.VarChar(100)
  registrationType  RegistrationType      @default(COMMERCIAL) @map("registration_type")
  customerName      String                @map("customer_name") @db.VarChar(255)
  customerMobile    String                @map("customer_mobile") @db.VarChar(20)
  customerEmail     String                @map("customer_email") @db.VarChar(255)
  ticketType        String                @default("COMMERCIAL_DAILY") @map("ticket_type") @db.VarChar(50)
  selectedDates     Json                  @map("selected_dates")
  quantity          Int                   @default(1)
  unitPricePaise    Int                   @map("unit_price_paise")
  amountPaise       Int                   @map("amount_paise")
  currency          String                @default("INR") @db.VarChar(10)
  orderStatus       OrderStatus           @default(PENDING) @map("order_status")
  paymentStatus     PaymentStatus         @default(CREATED) @map("payment_status")

  razorpayOrderId   String?               @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?               @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?               @map("razorpay_signature") @db.VarChar(255)

  paidAt            DateTime?             @map("paid_at")
  failedAt          DateTime?             @map("failed_at")
  failureReason     String?               @map("failure_reason") @db.Text

  metadata          Json?

  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  attendees         Attendee[]
  webhookEvents     PaymentWebhookEvent[]

  @@index([orderNumber])
  @@index([razorpayOrderId])
  @@index([customerMobile])
  @@index([orderStatus])
  @@map("commercial_orders")
}

model PaymentWebhookEvent {
  id             BigInt           @id @default(autoincrement())
  eventId        String           @unique @map("event_id") @db.VarChar(100)
  orderId        BigInt?          @map("order_id")
  eventType      String           @map("event_type") @db.VarChar(100)
  paymentId      String?          @map("payment_id") @db.VarChar(100)
  processed      Boolean          @default(false)
  payloadSummary Json?            @map("payload_summary")
  receivedAt     DateTime         @default(now()) @map("received_at")

  order          CommercialOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model DailyCheckin {
  id            BigInt        @id @default(autoincrement())
  attendeeId    BigInt        @map("attendee_id")
  gateId        BigInt        @map("gate_id")
  scannedById   BigInt?       @map("scanned_by_id")
  eventDate     String        @map("event_date") @db.VarChar(20)
  checkinTime   DateTime      @default(now()) @map("checkin_time")
  status        CheckinStatus @default(SUCCESS)
  isManual      Boolean       @default(false) @map("is_manual")
  manualReason  String?       @map("manual_reason") @db.Text
  voidedAt      DateTime?     @map("voided_at")
  voidedById    BigInt?       @map("voided_by_id")
  voidReason    String?       @map("void_reason") @db.Text
  isLoadTest    Boolean       @default(false) @map("is_load_test")
  loadTestRunId BigInt?       @map("load_test_run_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  attendee    Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  gate        Gate         @relation(fields: [gateId], references: [id], onDelete: Cascade)
  scannedBy   User?        @relation("ScannedByUser", fields: [scannedById], references: [id], onDelete: SetNull)
  voidedBy    User?        @relation("VoidedByUser", fields: [voidedById], references: [id], onDelete: SetNull)
  loadTestRun LoadTestRun? @relation(fields: [loadTestRunId], references: [id], onDelete: Cascade)

  @@unique([attendeeId, eventDate], name: "unique_attendee_event_date")
  @@index([eventDate, status])
  @@index([gateId, eventDate])
  @@index([isLoadTest])
  @@map("daily_checkins")
}

model ScanLog {
  id             BigInt   @id @default(autoincrement())
  attendeeId     BigInt?  @map("attendee_id")
  gateId         BigInt?  @map("gate_id")
  scannedById    BigInt?  @map("scanned_by_id")
  result         String   @db.VarChar(50)
  responseTimeMs Int      @default(0) @map("response_time_ms")
  isLoadTest     Boolean  @default(false) @map("is_load_test")
  loadTestRunId  BigInt?  @map("load_test_run_id")
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  scannedAt      DateTime @default(now()) @map("scanned_at")

  attendee    Attendee?    @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  gate        Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)
  scannedBy   User?        @relation("ScanLogUser", fields: [scannedById], references: [id], onDelete: SetNull)
  loadTestRun LoadTestRun? @relation(fields: [loadTestRunId], references: [id], onDelete: Cascade)

  @@index([scannedAt])
  @@index([result])
  @@index([isLoadTest])
  @@map("scan_logs")
}

model Incident {
  id              BigInt           @id @default(autoincrement())
  incidentNumber  String           @unique @map("incident_number") @db.VarChar(50)
  gateId          BigInt?          @map("gate_id")
  reportedById    BigInt           @map("reported_by_id")
  category        IncidentCategory @default(SECURITY)
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  title           String           @db.VarChar(255)
  description     String           @db.Text
  ticketId        String?          @map("ticket_id") @db.VarChar(50)
  attendeeId      BigInt?          @map("attendee_id")
  incidentDate    String?          @map("incident_date") @db.VarChar(20)
  incidentTime    String?          @map("incident_time") @db.VarChar(20)
  resolutionNotes String?          @map("resolution_notes") @db.Text
  resolvedById    BigInt?          @map("resolved_by_id")
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  gate       Gate?     @relation(fields: [gateId], references: [id], onDelete: SetNull)
  reportedBy User      @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  attendee   Attendee? @relation(fields: [attendeeId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([severity])
  @@index([status])
  @@index([ticketId])
  @@index([incidentDate])
  @@map("incidents")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  action    String   @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@map("audit_logs")
}

model Setting {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model LoadTestRun {
  id                 BigInt           @id @default(autoincrement())
  scenario           LoadTestScenario @default(NORMAL)
  mode               LoadTestMode     @default(REAL_HTTP)
  status             LoadTestStatus   @default(PREPARING)
  simulatedUsers     Int              @default(100) @map("simulated_users")
  rampUpSeconds      Int              @default(5) @map("ramp_up_seconds")
  startedById        BigInt?          @map("started_by_id")
  startTime          DateTime?        @map("start_time")
  endTime            DateTime?        @map("end_time")
  totalRequests      BigInt           @default(0) @map("total_requests")
  successfulRequests BigInt           @default(0) @map("successful_requests")
  duplicateRequests  BigInt           @default(0) @map("duplicate_requests")
  invalidRequests    BigInt           @default(0) @map("invalid_requests")
  errorRequests      BigInt           @default(0) @map("error_requests")
  requestsPerSecond  Float            @default(0) @map("requests_per_second")
  avgResponseTimeMs  Float            @default(0) @map("avg_response_time_ms")
  bytesTransferred   BigInt           @default(0) @map("bytes_transferred")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  checkins DailyCheckin[]
  scanLogs ScanLog[]
  requests LoadTestRequest[]

  @@map("load_test_runs")
}

model LoadTestRequest {
  id             BigInt   @id @default(autoincrement())
  runId          BigInt   @map("run_id")
  token          String   @db.VarChar(100)
  gateId         String   @map("gate_id") @db.VarChar(50)
  result         String   @db.VarChar(50)
  responseTimeMs Int      @map("response_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  run LoadTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("load_test_requests")
}
