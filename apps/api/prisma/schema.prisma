datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EVENT_ADMIN
  GATE_SUPERVISOR
  GATE_MANAGER
  GATE_OPERATOR
  SCANNER_STAFF
  HELP_DESK
  REGISTRATION_STAFF
  VOLUNTEER
  REPORT_VIEWER
}

enum GateType {
  REGULAR
  VIP
  OFFICIAL
  SERVICE
  EMERGENCY
}

enum GateStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AttendeeStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CheckinStatus {
  SUCCESS
  VOIDED
}

enum IncidentCategory {
  SECURITY
  CROWD
  MEDICAL
  VIP
  SYSTEM
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LoadTestMode {
  DRY_RUN
  REAL_HTTP
}

enum LoadTestStatus {
  PREPARING
  RUNNING
  COMPLETED
  FAILED
}

enum LoadTestScenario {
  NORMAL
  DUPLICATE
  PEAK_BURST
  INVALID_QR
  MIXED
}

model User {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  staffId   String?  @unique @map("staff_id") @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      UserRole @default(GATE_OPERATOR)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gateUsers        GateUser[]
  scannedCheckins  DailyCheckin[] @relation("ScannedByUser")
  scannedLogs      ScanLog[]      @relation("ScanLogUser")
  reportedIncidents Incident[]    @relation("IncidentReporter")
  auditLogs        AuditLog[]

  @@map("users")
}

model Gate {
  id               BigInt     @id @default(autoincrement())
  name             String     @db.VarChar(255)
  gateNumber       String     @unique @map("gate_number") @db.VarChar(50)
  gateType         GateType   @default(REGULAR) @map("gate_type")
  status           GateStatus @default(ACTIVE)
  capacityPerHour  Int?       @map("capacity_per_hour")
  totalCapacity    Int?       @map("total_capacity")
  capacityEnabled  Boolean    @default(false) @map("capacity_enabled")
  blockWhenFull    Boolean    @default(false) @map("block_when_full")
  isOpen           Boolean    @default(true) @map("is_open")
  isScanningPaused Boolean    @default(false) @map("is_scanning_paused")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  gateUsers     GateUser[]
  dailyCheckins DailyCheckin[]
  scanLogs      ScanLog[]
  incidents     Incident[]

  @@map("gates")
}

model GateUser {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  gateId     BigInt   @map("gate_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gate Gate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([userId, gateId])
  @@map("gate_users")
}

model Employee {
  id          BigInt   @id @default(autoincrement())
  cpf         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  designation String   @db.VarChar(255)
  department  String   @db.VarChar(255)
  phone       String   @db.VarChar(20)
  email       String   @db.VarChar(255)
  photoPath   String?  @map("photo_path") @db.VarChar(500)
  bookingDays Json     @map("booking_days")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  familyMembers FamilyMember[]
  attendees     Attendee[]

  @@index([cpf])
  @@index([phone])
  @@map("employees")
}

model FamilyMember {
  id         BigInt   @id @default(autoincrement())
  employeeId BigInt   @map("employee_id")
  name       String   @db.VarChar(255)
  relation   String   @db.VarChar(100)
  age        Int?
  gender     String?  @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendee Attendee?

  @@map("family_members")
}

model Attendee {
  id             BigInt         @id @default(autoincrement())
  name           String?        @db.VarChar(255)
  mobile         String?        @db.VarChar(20)
  email          String?        @db.VarChar(255)
  category       String?        @default("General") @db.VarChar(50)
  employeeId     BigInt?        @map("employee_id")
  familyMemberId BigInt?        @unique @map("family_member_id")
  ticketNumber   String         @unique @map("ticket_number") @db.VarChar(100)
  qrCodeToken    String         @unique @map("qr_code_token") @db.VarChar(100)
  status         AttendeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  familyMember  FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  dailyCheckins DailyCheckin[]
  scanLogs      ScanLog[]

  @@index([ticketNumber])
  @@index([qrCodeToken])
  @@index([mobile])
  @@map("attendees")
}

model DailyCheckin {
  id            BigInt        @id @default(autoincrement())
  attendeeId    BigInt        @map("attendee_id")
  gateId        BigInt        @map("gate_id")
  scannedById   BigInt?       @map("scanned_by_id")
  eventDate     String        @map("event_date") @db.VarChar(20)
  checkinTime   DateTime      @default(now()) @map("checkin_time")
  status        CheckinStatus @default(SUCCESS)
  isLoadTest    Boolean       @default(false) @map("is_load_test")
  loadTestRunId BigInt?       @map("load_test_run_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  attendee    Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  gate        Gate         @relation(fields: [gateId], references: [id], onDelete: Cascade)
  scannedBy   User?        @relation("ScannedByUser", fields: [scannedById], references: [id], onDelete: SetNull)
  loadTestRun LoadTestRun? @relation(fields: [loadTestRunId], references: [id], onDelete: Cascade)

  @@unique([attendeeId, eventDate], name: "unique_attendee_event_date")
  @@index([eventDate, status])
  @@index([gateId, eventDate])
  @@index([isLoadTest])
  @@map("daily_checkins")
}

model ScanLog {
  id             BigInt   @id @default(autoincrement())
  attendeeId     BigInt?  @map("attendee_id")
  gateId         BigInt?  @map("gate_id")
  scannedById    BigInt?  @map("scanned_by_id")
  result         String   @db.VarChar(50)
  responseTimeMs Int      @default(0) @map("response_time_ms")
  isLoadTest     Boolean  @default(false) @map("is_load_test")
  loadTestRunId  BigInt?  @map("load_test_run_id")
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  scannedAt      DateTime @default(now()) @map("scanned_at")

  attendee    Attendee?    @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  gate        Gate?        @relation(fields: [gateId], references: [id], onDelete: SetNull)
  scannedBy   User?        @relation("ScanLogUser", fields: [scannedById], references: [id], onDelete: SetNull)
  loadTestRun LoadTestRun? @relation(fields: [loadTestRunId], references: [id], onDelete: Cascade)

  @@index([scannedAt])
  @@index([result])
  @@index([isLoadTest])
  @@map("scan_logs")
}

model Incident {
  id              BigInt           @id @default(autoincrement())
  incidentNumber  String           @unique @map("incident_number") @db.VarChar(50)
  gateId          BigInt           @map("gate_id")
  reportedById    BigInt           @map("reported_by_id")
  category        IncidentCategory @default(SECURITY)
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  title           String           @db.VarChar(255)
  description     String           @db.Text
  resolutionNotes String?          @map("resolution_notes") @db.Text
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  gate       Gate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  reportedBy User @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([severity])
  @@index([status])
  @@map("incidents")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  action    String   @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@map("audit_logs")
}

model Setting {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model LoadTestRun {
  id                 BigInt           @id @default(autoincrement())
  scenario           LoadTestScenario @default(NORMAL)
  mode               LoadTestMode     @default(REAL_HTTP)
  status             LoadTestStatus   @default(PREPARING)
  simulatedUsers     Int              @default(100) @map("simulated_users")
  rampUpSeconds      Int              @default(5) @map("ramp_up_seconds")
  startedById        BigInt?          @map("started_by_id")
  startTime          DateTime?        @map("start_time")
  endTime            DateTime?        @map("end_time")
  totalRequests      BigInt           @default(0) @map("total_requests")
  successfulRequests BigInt           @default(0) @map("successful_requests")
  duplicateRequests  BigInt           @default(0) @map("duplicate_requests")
  invalidRequests    BigInt           @default(0) @map("invalid_requests")
  errorRequests      BigInt           @default(0) @map("error_requests")
  requestsPerSecond  Float            @default(0) @map("requests_per_second")
  avgResponseTimeMs  Float            @default(0) @map("avg_response_time_ms")
  bytesTransferred   BigInt           @default(0) @map("bytes_transferred")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  checkins DailyCheckin[]
  scanLogs ScanLog[]
  requests LoadTestRequest[]

  @@map("load_test_runs")
}

model LoadTestRequest {
  id             BigInt   @id @default(autoincrement())
  runId          BigInt   @map("run_id")
  token          String   @db.VarChar(100)
  gateId         String   @map("gate_id") @db.VarChar(50)
  result         String   @db.VarChar(50)
  responseTimeMs Int      @map("response_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  run LoadTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("load_test_requests")
}
