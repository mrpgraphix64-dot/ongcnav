# ==============================================================================
# ONGC NAVRATRI QR ENTRY CONTROL SYSTEM — ENVIRONMENT TEMPLATE
# Architecture: Next.js (Web) + NestJS (API) + PostgreSQL 16 + Redis 7/8
# ==============================================================================

# Node Environment ('staging' | 'production' | 'development')
NODE_ENV=staging
APP_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# API SERVER CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
PORT=3001
CORS_ORIGINS="http://localhost:3000,https://ongcnavratri.reworkzone.in"

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://ongc_user:SECURE_DB_PASSWORD@127.0.0.1:5432/ongc_navratri_db?schema=public"

# Redis Cache & Concurrency Lock Engine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# Security & Authentication (Generate using: openssl rand -base64 48)
# REQUIRED — the app refuses to start if this is unset, shorter than 32
# characters, or left as this placeholder value. No hardcoded fallback.
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_SECRET_KEY
JWT_EXPIRES_IN=7d

# Security Flags (MANDATORY: Keep false in staging and production)
LOAD_TESTING_ENABLED=true

# Internal shared secret required by POST /admin/traffic-test/execute-checkin
# (the x-load-test-auth header must match this exactly). Required for that
# endpoint to work at all — it fails closed if unset. Generate a fresh value
# per environment, e.g.: openssl rand -hex 32
LOAD_TEST_INTERNAL_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Emergency Admin Fallback Credentials — used only when no matching User
# row exists in the database yet. Both must be set for this path to work
# at all; there is no hardcoded default (fails closed if either is unset).
ADMIN_EMAIL=admin@ongc.co.in
ADMIN_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASS

# Private Storage Directory (Outside Public Web Root)
STORAGE_DIR=./storage/private

# Scanner check-in rate limit — max POST /scanner/checkin requests per
# authenticated scanner/staff user per rolling 60s window. Optional; falls
# back to a sensible default (120/min = 2/sec sustained) if unset. Fails
# open (no limiting) if Redis is unavailable — this is abuse protection,
# not part of the check-in correctness guarantee (Postgres's unique
# constraint on daily_checkins is what actually prevents duplicate entries).
SCANNER_RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Commercial Ticketing)
# ------------------------------------------------------------------------------
# Key ID is public-safe and provided to checkout; secret and webhook must be backend-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="ONGC Navratri Pass & Gate Control"
NEXT_PUBLIC_DEFAULT_EVENT_DATE=2026-09-23
